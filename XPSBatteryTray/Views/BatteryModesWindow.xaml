<Window x:Class="XPSBatteryTray.Views.BatteryModesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Modes"
        Width="430"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Battery Modes" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="-" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" />
                        <Button Content="X" Style="{StaticResource TitleCloseButtonStyle}" Click="CloseButton_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="16">
                <TextBlock Text="{Binding DellChargeSetting}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <WrapPanel>
                    <Button Content="Health 50-80" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Health" />
                    <Button Content="Balanced 70-90" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Balanced" />
                    <Button Content="Standard" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Standard" />
                    <Button Content="Primarily AC" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="PrimarilyAcUse" />
                    <Button Content="Adaptive" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Adaptive" />
                </WrapPanel>

                <Button Content="Refresh current setting" Command="{Binding RefreshDellChargeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
