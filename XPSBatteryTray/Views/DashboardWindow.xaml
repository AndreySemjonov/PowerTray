<Window x:Class="XPSBatteryTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XPSBatteryTray.Controls"
        Title="XPS Battery Tray"
        Width="520"
        Height="720"
        MinWidth="440"
        MinHeight="540"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="XPS Battery Tray" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Right" />
            </DockPanel>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Battery" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding BatterySummary}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding BatteryTimeText}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding BatteryPowerText}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding DellChargeSetting}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="CPU" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding CpuUsageText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CpuTemperatureText}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding CpuPowerText}" Foreground="{StaticResource MutedTextBrush}" />
                        <ProgressBar Value="{Binding CpuUsagePercent, Mode=OneWay}" Maximum="100" Height="7" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Memory" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding MemoryText}" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sensors" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding HwinfoStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding IsAdministrator, StringFormat=Admin: {0}}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Battery Modes" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshDellChargeCommand}" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Content="Health 50-80" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Health" />
                        <Button Content="Balanced 70-90" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Balanced" />
                        <Button Content="Standard" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Standard" />
                        <Button Content="Primarily AC" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="PrimarilyAcUse" />
                        <Button Content="Adaptive" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Adaptive" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Graphs" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="CPU usage" Foreground="{StaticResource MutedTextBrush}" />
                    <controls:SparklineControl Values="{Binding CpuGraphValues}" Stroke="{StaticResource AccentBrush}" Height="46" Margin="0,4,0,8" />
                    <TextBlock Text="Battery watts" Foreground="{StaticResource MutedTextBrush}" />
                    <controls:SparklineControl Values="{Binding BatteryWattsGraphValues}" Stroke="#E7B05B" Height="46" Margin="0,4,0,8" />
                    <TextBlock Text="CPU temperature" Foreground="{StaticResource MutedTextBrush}" />
                    <controls:SparklineControl Values="{Binding TemperatureGraphValues}" Stroke="#E26473" Height="46" Margin="0,4,0,8" />
                    <TextBlock Text="Fan RPM" Foreground="{StaticResource MutedTextBrush}" />
                    <controls:SparklineControl Values="{Binding FanGraphValues}" Stroke="#82D173" Height="46" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Top CPU Processes" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <ItemsControl ItemsSource="{Binding TopCpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,7,0,0">
                                        <TextBlock Text="{Binding CpuText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Top Memory Processes" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <ItemsControl ItemsSource="{Binding TopMemoryProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,7,0,0">
                                        <TextBlock Text="{Binding MemoryText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Estimated Energy Impact" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <ItemsControl ItemsSource="{Binding EnergyImpactProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,7,0,0">
                                    <TextBlock Text="{Binding EnergyText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Thermal / Fans" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <ItemsControl ItemsSource="{Binding FanReadings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
