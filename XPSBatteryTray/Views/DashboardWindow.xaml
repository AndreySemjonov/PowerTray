<Window x:Class="XPSBatteryTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XPSBatteryTray.Controls"
        Title="XPS Battery Tray"
        Width="760"
        Height="1080"
        MinWidth="720"
        MinHeight="980"
        MaxWidth="800"
        MaxHeight="1120"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="54" />
                <RowDefinition Height="190" />
                <RowDefinition Height="190" />
                <RowDefinition Height="190" />
                <RowDefinition Height="190" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Background="#1F6FEB" BorderBrush="#79C0FF" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="XPS Battery Tray" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="ModesButton" Content="Modes" Click="ModesButton_Click" MinWidth="88" Height="38" Margin="0,0,10,0">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Battery Health: Custom 50-80" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Health" />
                                    <MenuItem Header="Balanced: Custom 70-90" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Balanced" />
                                    <MenuItem Header="Charge to Full: Standard" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Standard" />
                                    <MenuItem Header="Primarily AC Use" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="PrimarilyAcUse" />
                                    <MenuItem Header="Adaptive" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Adaptive" />
                                    <Separator />
                                    <MenuItem Header="Show Current Setting" Command="{Binding RefreshDellChargeCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="⚙" Command="{Binding OpenSettingsCommand}" Width="46" Height="38" MinWidth="46" FontSize="18" ToolTip="Settings" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" />
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" IsEnabled="False" Opacity="0.55" />
                        <Button Content="X" Style="{StaticResource TitleCloseButtonStyle}" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,8">
                <Border Style="{StaticResource ChipStyle}" Width="222" Margin="0,0,10,0" ToolTip="{Binding DellChargeSetting}">
                    <DockPanel>
                        <TextBlock Text="↯" Foreground="{StaticResource AccentBrush}" FontSize="18" DockPanel.Dock="Left" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ModeChipText}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}" Width="170" Margin="0,0,10,0">
                    <DockPanel>
                        <TextBlock Text="✓" Foreground="{StaticResource GoodAccentBrush}" FontSize="18" DockPanel.Dock="Left" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding HwinfoChipText}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}" Width="158">
                    <DockPanel>
                        <TextBlock Text="▭" Foreground="{StaticResource AccentBrush}" FontSize="18" DockPanel.Dock="Left" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding PowerStateChipText}" FontSize="15" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="14,0,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Battery" Style="{StaticResource SmallHeaderStyle}" />
                            <controls:BatteryGaugeControl Percentage="{Binding BatteryLevelPercent}" Accent="{StaticResource AccentBrush}" Width="72" Height="98" Margin="4,18,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BatteryPercentText}" FontSize="34" FontWeight="Bold" />
                            <TextBlock Text="{Binding PowerStateText}" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding BatteryPowerText}" FontSize="16" Foreground="{StaticResource BatteryAccentBrush}" />
                            <TextBlock Text="{Binding BatteryTimeText}" Style="{StaticResource MutedStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FriendlyChargeMode}" Style="{StaticResource MutedStyle}" Margin="0,8,0,0" TextWrapping="Wrap" ToolTip="{Binding DellChargeSetting}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource SmallHeaderStyle}" />
                            <Grid Width="120" Height="120" Margin="0,12,0,0">
                                <controls:RingGaugeControl Value="{Binding CpuGaugeValue}" Accent="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding CpuUsageText}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource PanelBorder}" Margin="0,36,18,12" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CpuTemperatureDisplay}" FontSize="16" Margin="0,0,0,12" Foreground="{StaticResource ThermalAccentBrush}" />
                            <TextBlock Text="{Binding CpuPackagePowerDisplay}" FontSize="16" Margin="0,0,0,12" Foreground="{StaticResource ThermalAccentBrush}" />
                            <TextBlock Text="{Binding TopCpuProcessText}" FontSize="14" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="14,0,14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="⚡  Battery watts" Foreground="{StaticResource BatteryAccentBrush}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BatteryWattsGraphSummary}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                    </DockPanel>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding BatteryWattsGraphValues}" Stroke="{StaticResource BatteryAccentBrush}" Fill="#33F5AA2D" Height="140" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="14,0,14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="⚡  CPU package power" Foreground="{StaticResource ThermalAccentBrush}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CpuPowerGraphSummary}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                    </DockPanel>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding CpuPowerGraphValues}" Stroke="{StaticResource ThermalAccentBrush}" Fill="#33FF6F87" Height="140" />
                </Grid>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="14,0,14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="♨  CPU temperature" Foreground="{StaticResource ThermalAccentBrush}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TemperatureGraphSummary}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                    </DockPanel>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding TemperatureGraphValues}" Stroke="{StaticResource ThermalAccentBrush}" Fill="#2AFF6F87" Height="140" />
                </Grid>
            </Border>

            <Grid Grid.Row="6" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="▣  Top CPU Processes" Style="{StaticResource SmallHeaderStyle}" FontSize="14" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="CPU %" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TopCpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="♧  Estimated Energy Impact" Foreground="{StaticResource GoodAccentBrush}" FontSize="14" FontWeight="SemiBold" ToolTip="Relative estimate based on CPU activity and runtime, not measured process watts." />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="Impact" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding EnergyImpactProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding EnergyText}" HorizontalAlignment="Right" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
