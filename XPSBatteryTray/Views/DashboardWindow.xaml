<Window x:Class="XPSBatteryTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XPSBatteryTray.Controls"
        Title="XPS Battery Tray"
        Width="500"
        Height="640"
        MinWidth="440"
        MinHeight="500"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="#512BD4" CornerRadius="3" Width="20" Height="20" Margin="0,0,8,0">
                        <TextBlock Text=".NET" FontSize="7" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="XPS Battery Tray" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="-" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" />
                    <Button Content="X" Style="{StaticResource TitleCloseButtonStyle}" Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBg}">
        <StackPanel Margin="12" Background="{StaticResource WindowBg}">
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" MaxWidth="300">
                    <TextBlock Text="XPS Battery Tray" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Modes" Command="{Binding OpenBatteryModesCommand}" Margin="8,0,0,0" />
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Battery" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding BatterySummary}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding BatteryTimeText}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding BatteryPowerText}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding DellChargeSetting}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="CPU" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding CpuUsageText}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding CpuTemperatureText}" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding CpuPowerText}" Foreground="{StaticResource MutedTextBrush}" />
                        <ProgressBar Value="{Binding CpuUsagePercent, Mode=OneWay}" Maximum="100" Height="7" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Memory" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding MemoryText}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sensors" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding HwinfoStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding IsAdministrator, StringFormat=Admin: {0}}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Graphs" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="CPU usage" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding CpuGraphSummary}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </DockPanel>
                    <controls:SparklineControl Values="{Binding CpuGraphValues}" Stroke="{StaticResource AccentBrush}" Height="58" Margin="0,4,0,10" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Battery watts" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding BatteryWattsGraphSummary}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </DockPanel>
                    <controls:SparklineControl Values="{Binding BatteryWattsGraphValues}" Stroke="#E7B05B" Height="58" Margin="0,4,0,10" />
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="CPU temperature" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding TemperatureGraphSummary}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </DockPanel>
                    <controls:SparklineControl Values="{Binding TemperatureGraphValues}" Stroke="#E26473" Height="58" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Top CPU Processes" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <ItemsControl ItemsSource="{Binding TopCpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,7,0,0">
                                        <TextBlock Text="{Binding CpuText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Top Memory Processes" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <ItemsControl ItemsSource="{Binding TopMemoryProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,7,0,0">
                                        <TextBlock Text="{Binding MemoryText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Estimated Energy Impact" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <ItemsControl ItemsSource="{Binding EnergyImpactProcesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,7,0,0">
                                    <TextBlock Text="{Binding EnergyText}" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    </Grid>
    </Border>
</Window>
