<Window x:Class="XPSBatteryTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XPSBatteryTray.Controls"
        Title="XPS Battery Tray"
        Width="700"
        Height="900"
        MinWidth="680"
        MinHeight="860"
        MaxWidth="720"
        MaxHeight="920"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="42" />
                <RowDefinition Height="148" />
                <RowDefinition Height="150" />
                <RowDefinition Height="150" />
                <RowDefinition Height="150" />
                <RowDefinition Height="178" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Background="#1F6FEB" BorderBrush="#79C0FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="XPS Battery Tray" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="ModesButton" Content="Modes" Click="ModesButton_Click" MinWidth="72" Height="32" Margin="0,0,8,0">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Battery Health: Custom 50-80" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Health" />
                                    <MenuItem Header="Balanced: Custom 70-90" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Balanced" />
                                    <MenuItem Header="Charge to Full: Standard" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Standard" />
                                    <MenuItem Header="Primarily AC Use" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="PrimarilyAcUse" />
                                    <MenuItem Header="Adaptive" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Adaptive" />
                                    <Separator />
                                    <MenuItem Header="Show Current Setting" Command="{Binding RefreshDellChargeCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="⚙" Command="{Binding OpenSettingsCommand}" Width="38" Height="32" MinWidth="38" FontSize="15" ToolTip="Settings" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" />
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" IsEnabled="False" Opacity="0.55" />
                        <Button Content="X" Style="{StaticResource TitleCloseButtonStyle}" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,8,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ChipStyle}" ToolTip="{Binding DellChargeSetting}">
                    <DockPanel>
                        <TextBlock Text="↯" Foreground="{StaticResource AccentBrush}" FontSize="14" DockPanel.Dock="Left" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ModeChipText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ChipStyle}">
                    <DockPanel>
                        <TextBlock Text="✓" Foreground="{StaticResource GoodAccentBrush}" FontSize="14" DockPanel.Dock="Left" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding HwinfoChipText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource ChipStyle}">
                    <DockPanel>
                        <TextBlock Text="▭" Foreground="{StaticResource AccentBrush}" FontSize="14" DockPanel.Dock="Left" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding PowerStateChipText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource ChipStyle}">
                    <DockPanel>
                        <TextBlock Text="▣" Foreground="{StaticResource GoodAccentBrush}" FontSize="14" DockPanel.Dock="Left" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding AdminChipText}" FontSize="13" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="0.92*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Battery" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:BatteryGaugeControl Grid.Column="0" Percentage="{Binding BatteryLevelPercent}" Accent="{StaticResource AccentBrush}" Width="58" Height="88" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BatteryPercentText}" FontSize="40" FontWeight="Bold" LineHeight="42" />
                                <TextBlock Text="{Binding PowerStateText}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding BatteryPowerText}" FontSize="15" Foreground="{StaticResource BatteryAccentBrush}" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding BatteryTimeText}" Style="{StaticResource MutedStyle}" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding FriendlyChargeMode}" Style="{StaticResource MutedStyle}" Margin="0,8,0,0" TextWrapping="Wrap" ToolTip="{Binding DellChargeSetting}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource PanelBorder}" Margin="0,12" />

                    <Grid Grid.Column="2" Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="80" Height="80" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <controls:RingGaugeControl Value="{Binding CpuGaugeValue}" Accent="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding CpuUsageText}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CpuTemperatureDisplay}" FontSize="15" Margin="0,0,0,9" Foreground="{StaticResource ThermalAccentBrush}" />
                            <TextBlock Text="{Binding CpuPackagePowerDisplay}" FontSize="15" Margin="0,0,0,9" Foreground="{StaticResource ThermalAccentBrush}" />
                            <TextBlock Text="{Binding TopCpuProcessText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚡  Battery watts" Foreground="{StaticResource BatteryAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding BatteryWattsGraphSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </Grid>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding BatteryWattsGraphValues}" Stroke="{StaticResource BatteryAccentBrush}" Fill="#33F5AA2D" Height="102" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚡  CPU package power" Foreground="{StaticResource ThermalAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding CpuPowerGraphSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </Grid>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding CpuPowerGraphValues}" Stroke="{StaticResource ThermalAccentBrush}" Fill="#33FF6F87" Height="102" />
                </Grid>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="♨  CPU temperature" Foreground="{StaticResource ThermalAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding TemperatureGraphSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </Grid>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding TemperatureGraphValues}" Stroke="{StaticResource ThermalAccentBrush}" Fill="#2AFF6F87" Height="102" />
                </Grid>
            </Border>

            <Grid Grid.Row="6" Margin="10,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="▣  Top CPU Processes" Style="{StaticResource SmallHeaderStyle}" FontSize="14" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="CPU %" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TopCpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="20" Margin="0,1,0,0">
                                        <ProgressBar Grid.ColumnSpan="2" Style="{StaticResource MiniBarStyle}" Value="{Binding CpuPercent}" Maximum="100" Foreground="#3F82CB" Opacity="0.45" VerticalAlignment="Center" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="♧  Energy Impact (10m)" Foreground="{StaticResource GoodAccentBrush}" FontSize="14" FontWeight="SemiBold" ToolTip="Rolling 10-minute relative estimate based on accumulated CPU activity, not measured process watts." />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="10m score" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding EnergyImpactProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="20" Margin="0,1,0,0">
                                        <ProgressBar Grid.ColumnSpan="2" Style="{StaticResource MiniBarStyle}" Value="{Binding EstimatedEnergyImpactBarPercent}" Maximum="100" Foreground="#4E9C52" Opacity="0.42" VerticalAlignment="Center" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding EnergyText}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="7" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11">
                <TextBlock Text="{Binding FooterStatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0" />
            </Border>
        </Grid>
    </Border>
</Window>
