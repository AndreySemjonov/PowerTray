<Window x:Class="PowerTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerTray Settings"
        Width="820"
        Height="870"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="11"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TopBarBg}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="PowerTray Settings"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="-"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button Content="X"
                                Style="{StaticResource TitleCloseButtonStyle}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Settings"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Startup, sensors, dimmer, battery presets, and appearance"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,1,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="300" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Dell Command"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="Browse"
                                        Command="{Binding BrowseCommand}"
                                        Width="86"
                                        Height="32"
                                        Margin="8,0,0,0" />
                                 <TextBox Text="{Binding CctkPath, UpdateSourceTrigger=PropertyChanged}" />
                             </DockPanel>
                            <CheckBox Grid.Row="2"
                                      Content="Use BIOS setup password for Dell commands"
                                      IsChecked="{Binding UseBiosSetupPassword}"
                                      Margin="0,8,0,0" />
                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <PasswordBox x:Name="BiosSetupPasswordBox"
                                             PasswordChanged="BiosSetupPasswordBox_PasswordChanged"
                                             ToolTip="Stored encrypted for the current Windows user. Leave empty to keep the saved password." />
                                <Button Grid.Column="1"
                                        Content="Clear"
                                        Command="{Binding ClearBiosSetupPasswordCommand}"
                                        Height="32"
                                        Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding BiosSetupPasswordStatusText}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Dell Thermal Profile"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Control mode"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DellThermalControlModes}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding DellThermalControlMode}" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Efficiency"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DellThermalProfiles}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding PowerEfficiencyThermalProfile}" />

                                    <TextBlock Grid.Row="2"
                                               Text="Balanced"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2"
                                              Grid.Column="1"
                                              ItemsSource="{Binding DellThermalProfiles}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding BalancedThermalProfile}" />

                                    <TextBlock Grid.Row="4"
                                               Text="Performance"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="4"
                                              Grid.Column="1"
                                              ItemsSource="{Binding DellThermalProfiles}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding PerformanceThermalProfile}" />

                                    <TextBlock Grid.Row="6"
                                               Text="Plugged in"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="6"
                                              Grid.Column="1"
                                              ItemsSource="{Binding DellThermalProfiles}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ManualPluggedInThermalProfile}" />

                                    <TextBlock Grid.Row="8"
                                               Text="On battery"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="8"
                                              Grid.Column="1"
                                              ItemsSource="{Binding DellThermalProfiles}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding ManualBatteryThermalProfile}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Startup And Sensors"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <UniformGrid Grid.Row="1" Columns="1" Margin="0,8,0,0">
                                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                                    <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" />
                                    <CheckBox Content="Enable HWiNFO shared-memory sensors" IsChecked="{Binding EnableHwinfoIntegration}" />
                                    <CheckBox Content="Auto-restart HWiNFO if shared memory disappears" IsChecked="{Binding EnableHwinfoAutoRestart}" />
                                    <CheckBox Content="Run personal HWiNFO recovery script" IsChecked="{Binding EnableHwinfoPersonalRecoveryScript}" />
                                    <CheckBox Content="Enable built-in LibreHardwareMonitor sensors" IsChecked="{Binding EnableLibreHardwareMonitorIntegration}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="2"
                                           Text="Personal recovery script"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,2,0,4" />
                                <DockPanel Grid.Row="3">
                                    <Button DockPanel.Dock="Right"
                                            Content="Browse"
                                            Command="{Binding BrowseHwinfoRecoveryScriptCommand}"
                                            Width="86"
                                            Height="32"
                                            Margin="8,0,0,0" />
                                    <TextBox Text="{Binding HwinfoPersonalRecoveryScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Behavior"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2"
                                       Text="Appearance"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sample interval seconds"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding SensorSampleIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Health preset start / stop"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding HealthStart}" />
                                <TextBlock Grid.Column="2"
                                           Text="-"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Text="{Binding HealthStop}" />
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Balanced preset start / stop"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding BalancedStart}" />
                                <TextBlock Grid.Column="2"
                                           Text="-"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Text="{Binding BalancedStop}" />
                            </Grid>

                            <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Margin="0,8,0,0">
                                <CheckBox Content="Show Battery Watts tile" IsChecked="{Binding ShowBatteryWattsTile}" />
                                <CheckBox Content="Show CPU / GPU Usage tile" IsChecked="{Binding ShowCpuGpuUsageTile}" />
                                <CheckBox Content="Show Battery Usage / Impact (24h)" IsChecked="{Binding ShowBatteryUsageSection}" />
                                <CheckBox Content="Enable screen dimmer" IsChecked="{Binding EnableScreenDimmer}" />
                                <CheckBox Content="Extend brightness keys below minimum" IsChecked="{Binding ExtendBrightnessKeysWithDimmer}" IsEnabled="{Binding CanExtendBrightnessKeysWithDimmer}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="156" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Themes}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Theme}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Width="86"
                                Height="32"
                                Margin="0,0,8,0" />
                        <Button Content="Close"
                                Click="CloseButton_Click"
                                Width="86"
                                Height="32" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
