<Window x:Class="PowerTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerTray Settings"
        Width="900"
        Height="770"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="11"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TopBarBg}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="PowerTray Settings"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="-"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button Content="X"
                                Style="{StaticResource TitleCloseButtonStyle}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Settings"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Startup, sensors, battery presets, and appearance"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Dell Command"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1"
                                           Text="Path to cctk.exe"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,12,0,5" />
                                <DockPanel Grid.Row="2">
                                    <Button DockPanel.Dock="Right"
                                            Content="Browse"
                                            Command="{Binding BrowseCommand}"
                                            Width="94"
                                            Height="34"
                                            Margin="10,0,0,0" />
                                    <TextBox Text="{Binding CctkPath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Startup And Sensors"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <UniformGrid Grid.Row="1" Columns="2" Margin="0,12,0,4">
                                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                                    <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" />
                                    <CheckBox Content="Enable HWiNFO shared-memory sensors" IsChecked="{Binding EnableHwinfoIntegration}" />
                                    <CheckBox Content="Auto-restart HWiNFO if shared memory disappears" IsChecked="{Binding EnableHwinfoAutoRestart}" />
                                    <CheckBox Content="Run personal HWiNFO recovery script" IsChecked="{Binding EnableHwinfoPersonalRecoveryScript}" />
                                    <CheckBox Content="Enable built-in LibreHardwareMonitor sensors" IsChecked="{Binding EnableLibreHardwareMonitorIntegration}" />
                                </UniformGrid>

                                <TextBlock Grid.Row="2"
                                           Text="Personal HWiNFO recovery script"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,8,0,5" />
                                <DockPanel Grid.Row="3">
                                    <Button DockPanel.Dock="Right"
                                            Content="Browse"
                                            Command="{Binding BrowseHwinfoRecoveryScriptCommand}"
                                            Width="94"
                                            Height="34"
                                            Margin="10,0,0,0" />
                                    <TextBox Text="{Binding HwinfoPersonalRecoveryScriptPath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Behavior"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2"
                                           Text="Appearance"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sample interval seconds"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SensorSampleIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Health preset start / stop"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding HealthStart}" />
                                    <TextBlock Grid.Column="2"
                                               Text="-"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding HealthStop}" />
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="68" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Balanced preset start / stop"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding BalancedStart}" />
                                    <TextBlock Grid.Column="2"
                                               Text="-"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding BalancedStop}" />
                                </Grid>

                                <Grid Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="178" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Themes}"
                                              SelectedItem="{Binding Theme}" />
                                </Grid>
                            </Grid>
                        </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Width="94"
                                Height="34"
                                Margin="0,0,8,0" />
                        <Button Content="Close"
                                Click="CloseButton_Click"
                                Width="94"
                                Height="34" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
