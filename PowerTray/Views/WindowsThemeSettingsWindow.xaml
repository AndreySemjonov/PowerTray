<Window x:Class="PowerTray.Views.WindowsThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi Profiles"
        Width="1180"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="11"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TopBarBg}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Wi-Fi Profiles"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="-"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button Content="X"
                                Style="{StaticResource TitleCloseButtonStyle}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Wi-Fi Profiles"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Apply theme, Windows power plan, and Dell thermal profile from the current Wi-Fi network."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,1,0,0" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <CheckBox Content="Show title-bar light/dark toggle"
                                  IsChecked="{Binding ShowWindowsThemeToggle}" />

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Automation"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AutomationModes}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding AutomationMode}" />
                        </Grid>

                        <Grid Grid.Row="4" IsEnabled="{Binding IsWifiAutomationEnabled}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Current Wi-Fi"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding CurrentWifiSsid}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Refresh"
                                        Command="{Binding RefreshWifiCommand}"
                                        Height="32" />
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Action"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="1"
                                           Text="Theme"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="2"
                                           Text="Plugged in power"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="3"
                                           Text="Plugged in Dell thermal"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="4"
                                           Text="On battery power"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="5"
                                           Text="On battery Dell thermal"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />

                                <TextBlock Grid.Row="2"
                                           Text="Add / update"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          ItemsSource="{Binding ThemeModes}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewRuleTheme}" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="2"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding PowerModes}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewRulePluggedInPowerMode}" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="3"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding DellThermalActions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewRulePluggedInDellThermalAction}" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="4"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding PowerModes}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewRuleBatteryPowerMode}" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="5"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding DellThermalActions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding NewRuleBatteryDellThermalAction}" />
                                <Button Grid.Row="2"
                                        Grid.Column="6"
                                        Margin="8,0,0,0"
                                        Content="Add / Update"
                                        Command="{Binding AddCurrentWifiRuleCommand}"
                                        Height="32" />
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Wi-Fi"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="1"
                                           Text="Theme"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="2"
                                           Text="Plugged in power"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Column="3"
                                           Text="Plugged in Dell thermal"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Column="4"
                                           Text="On battery power"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Column="5"
                                           Text="On battery Dell thermal"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <ListBox Grid.Row="6"
                                     ItemsSource="{Binding WifiRules}"
                                     BorderBrush="{DynamicResource PanelBorder}"
                                     Background="{DynamicResource InputBg}"
                                     MinHeight="310"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Resources>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThemedScrollBarStyle}" />
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="142" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Ssid}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding DataContext.ThemeModes, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Theme}" />
                                            <ComboBox Grid.Column="2"
                                                      Margin="8,0,0,0"
                                                      ItemsSource="{Binding DataContext.PowerModes, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding PluggedInPowerMode}" />
                                            <ComboBox Grid.Column="3"
                                                      Margin="8,0,0,0"
                                                      ItemsSource="{Binding DataContext.DellThermalActions, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding PluggedInDellThermalAction}" />
                                            <ComboBox Grid.Column="4"
                                                      Margin="8,0,0,0"
                                                      ItemsSource="{Binding DataContext.PowerModes, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding BatteryPowerMode}" />
                                            <ComboBox Grid.Column="5"
                                                      Margin="8,0,0,0"
                                                      ItemsSource="{Binding DataContext.DellThermalActions, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding BatteryDellThermalAction}" />
                                            <Button Grid.Column="6"
                                                    Margin="8,0,0,0"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Height="30" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Width="86"
                                Height="32"
                                Margin="0,0,8,0" />
                        <Button Content="Close"
                                Click="CloseButton_Click"
                                Width="86"
                                Height="32" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
