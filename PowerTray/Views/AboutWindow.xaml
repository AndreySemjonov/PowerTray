<Window x:Class="PowerTray.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PowerTray"
        Width="420"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="11"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TopBarBg}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="About PowerTray"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <Button Content="X"
                            DockPanel.Dock="Right"
                            Style="{StaticResource TitleCloseButtonStyle}"
                            Click="CloseButton_Click" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="PowerTray"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"
                                   LineHeight="19"
                                   Text="PowerTray is a lightweight Windows tray utility for quick Dell battery mode, Windows power plan, Dell thermal profile, battery history, and CPU/GPU monitoring." />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Author" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="Andrejs Semjonovs" />

                            <TextBlock Grid.Row="1" Text="License" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="GPLv3" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="2" Text="GitHub" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="github.com/AndreySemjonov/PowerTray" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />

                            <TextBlock Grid.Row="3" Text="Sensors" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="HWiNFO optional" Margin="0,8,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Open GitHub"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="OpenGitHubButton_Click" />
                    <Button Content="Close"
                            Width="100"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
