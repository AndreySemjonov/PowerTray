<Window x:Class="XPSBatteryTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XPSBatteryTray.Controls"
        Title="PowerTray"
        Width="520"
        Height="1160"
        MinWidth="450"
        MinHeight="1000"
        MaxWidth="640"
        MaxHeight="1200"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="42" />
                <RowDefinition Height="182" />
                <RowDefinition Height="200" />
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Background="#1F6FEB" BorderBrush="#79C0FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PowerTray" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" Click="MinimizeButton_Click" />
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" IsEnabled="False" Opacity="0.55" />
                        <Button Content="X" Style="{StaticResource TitleCloseButtonStyle}" Width="36" MinWidth="36" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10,7,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PowerButton" Grid.Column="0" Content="{Binding PowerModeButtonText}" ToolTip="{Binding PowerModeButtonToolTip}" Click="PowerButton_Click" Height="30" Padding="8,3" FontSize="12" HorizontalContentAlignment="Center">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding PowerModeButtonToolTip}" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="{Binding PowerEfficiencyMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="BestPowerEfficiency" />
                            <MenuItem Header="{Binding BalancedPowerModeMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="Balanced" />
                            <MenuItem Header="{Binding PerformancePowerModeMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="BestPerformance" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ModesButton" Grid.Column="2" Content="{Binding ModeChipText}" ToolTip="{Binding DellChargeSetting}" Click="ModesButton_Click" Height="30" Padding="8,3" FontSize="12" HorizontalContentAlignment="Center">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Battery Health: Custom 50-80" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Health" />
                            <MenuItem Header="Balanced: Custom 70-90" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Balanced" />
                            <MenuItem Header="Charge to Full: Standard" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Standard" />
                            <MenuItem Header="Primarily AC Use" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="PrimarilyAcUse" />
                            <MenuItem Header="Adaptive" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Adaptive" />
                            <Separator />
                            <MenuItem Header="Show Current Setting" Command="{Binding RefreshDellChargeCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="4" Content="⚙" Command="{Binding OpenSettingsCommand}" Width="42" Height="30" MinWidth="42" Padding="0" FontSize="14" ToolTip="Settings" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Battery" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:BatteryGaugeControl Grid.Column="0" Percentage="{Binding BatteryLevelPercent}" Accent="{StaticResource AccentBrush}" Width="48" Height="74" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,18,0,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BatteryPercentText}" FontSize="25" FontWeight="Bold" LineHeight="35" Height="31" />
                                <TextBlock Text="{Binding PowerStateText}" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding BatteryPowerText}" FontSize="12" Foreground="{StaticResource BatteryAccentBrush}" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding BatteryTimeText}" Style="{StaticResource MutedStyle}" Margin="0,7,0,0" />
                                <TextBlock Text="{Binding FriendlyChargeMode}" Style="{StaticResource MutedStyle}" Margin="0,8,0,0" TextWrapping="Wrap" ToolTip="{Binding DellChargeSetting}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource PanelBorder}" Margin="0,12" />

                    <Grid Grid.Column="2" Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="66" Height="66" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <controls:RingGaugeControl Value="{Binding CpuGaugeValue}" Accent="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5" >
                                <controls:RingGaugeControl.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform AngleX="-0.674"/>
                                        <RotateTransform/>
                                        <TranslateTransform X="0.388"/>
                                    </TransformGroup>
                                </controls:RingGaugeControl.RenderTransform>
                            </controls:RingGaugeControl>
                            <TextBlock Text="{Binding CpuUsageText}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CpuTemperatureDisplay}" FontSize="15" Margin="0,0,0,9" Foreground="{StaticResource ThermalAccentBrush}" />
                            <TextBlock Text="{Binding CpuPackagePowerDisplay}" FontSize="15" Margin="0,0,0,9" Foreground="{StaticResource ThermalAccentBrush}" />
                            <TextBlock Text="{Binding TopCpuProcessText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚡  Battery watts" Foreground="{StaticResource BatteryAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding BatteryWattsGraphSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </Grid>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding BatteryWattsGraphValues}" Stroke="{StaticResource BatteryAccentBrush}" Fill="#33F5AA2D" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="♨  CPU temperature" Foreground="{StaticResource ThermalAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding TemperatureGraphSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </Grid>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding TemperatureGraphValues}" Stroke="{StaticResource ThermalAccentBrush}" Fill="#2AFF6F87" />
                </Grid>
            </Border>

            <Grid Grid.Row="5" Margin="10,0,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="314" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="146" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding BatteryUsageTitle}" Foreground="{StaticResource GoodAccentBrush}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&lt;" Command="{Binding PreviousBatteryUsageDayCommand}" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0" FontSize="12" ToolTip="Previous day" />
                                <Button Content="{Binding BatteryUsageDateText}" Command="{Binding TodayBatteryUsageCommand}" Width="68" MinWidth="68" Height="26" MinHeight="26" Padding="4,0" FontSize="11" Margin="5,0" ToolTip="Today" />
                                <Button Content="&gt;" Command="{Binding NextBatteryUsageDayCommand}" IsEnabled="{Binding CanShowNextBatteryUsageDay}" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0" FontSize="12" ToolTip="Next day" />
                            </StackPanel>
                        </Grid>

                        <controls:BatteryUsageCombinedControl Grid.Row="1" Buckets="{Binding BatteryUsageBuckets}" Margin="0,2,0,0" />

                        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Fill="#8E949A" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Level" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0" />
                            <Ellipse Fill="#9AD76C" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Charge" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0" />
                            <Ellipse Fill="#54D6C6" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hold" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0" />
                            <Ellipse Fill="#58A6FF" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Sleep" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0" />
                            <Canvas Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="#34C4CCD6" Stroke="#C4CCD6" StrokeThickness="1" StrokeDashArray="2,1" />
                            </Canvas>
                            <TextBlock Text="Missing" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0" />
                            <Ellipse Fill="#EDB848" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Saver" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0" />
                            <Ellipse Fill="#D65C53" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Critical" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0" />
                            <Border Background="#2A2E34" BorderBrush="#585E66" BorderThickness="1" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="No data" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Top app usage" Foreground="{StaticResource GoodAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="% used" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding TopAppUsageEmptyText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding EnergyImpactProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                                <Border Background="#232A31" Height="5" CornerRadius="2.5" />
                                                <ProgressBar Style="{StaticResource MiniBarStyle}" Value="{Binding EstimatedEnergyImpactBarPercent}" Maximum="100" Height="5" Foreground="#6A9DFF" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding EnergyText}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>


            <Border Grid.Row="6" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11">
                <TextBlock Text="{Binding FooterStatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0" />
            </Border>
        </Grid>
    </Border>
</Window>
