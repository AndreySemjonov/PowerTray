<Window x:Class="PowerTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PowerTray.Controls"
        Title="PowerTray"
        Width="620"
        Height="{Binding DashboardWindowHeight}"
        MinWidth="520"
        MinHeight="290"
        MaxWidth="640"
        MaxHeight="980"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Topmost="{Binding IsDashboardTopmost}"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Border x:Name="DashboardRoot"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid x:Name="DashboardContent" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding DashboardGraphRowHeight}" />
                <RowDefinition Height="{Binding DashboardLowerSectionRowHeight}" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TopBarBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PowerTray" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppVersionText}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="8,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE946;" FontFamily="Segoe MDL2 Assets" Click="AboutButton_Click" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" ToolTip="About PowerTray" />
                        <Button Content="&#xE718;" FontFamily="Segoe MDL2 Assets" Click="DashboardBehaviorButton_Click" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" ToolTip="{Binding DashboardBehaviorButtonToolTip}">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Auto hide on focus loss" Command="{Binding SetDashboardWindowBehaviorCommand}" CommandParameter="AutoHide" IsCheckable="True" IsChecked="{Binding IsDashboardAutoHideSelected, Mode=OneWay}" />
                                    <MenuItem Header="Close manually" Command="{Binding SetDashboardWindowBehaviorCommand}" CommandParameter="ManualClose" IsCheckable="True" IsChecked="{Binding IsDashboardManualCloseSelected, Mode=OneWay}" />
                                    <MenuItem Header="Stay on top" Command="{Binding SetDashboardWindowBehaviorCommand}" CommandParameter="StayOnTop" IsCheckable="True" IsChecked="{Binding IsDashboardStayOnTopSelected, Mode=OneWay}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="{Binding BackgroundRecordingButtonText}" FontFamily="Segoe UI Symbol" Command="{Binding ToggleBackgroundRecordingCommand}" Width="36" MinWidth="36" ToolTip="{Binding BackgroundRecordingButtonToolTip}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TitleBarButtonStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBackgroundRecordingEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#xE706;" FontFamily="Segoe MDL2 Assets" Command="{Binding OpenDimmerCommand}" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" ToolTip="{Binding ScreenDimmerButtonToolTip}" Visibility="{Binding ScreenDimmerButtonVisibility}" />
                        <Button Content="{Binding WindowsThemeToggleIcon}" FontFamily="Segoe UI Symbol" Command="{Binding ToggleWindowsThemeCommand}" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" ToolTip="{Binding WindowsThemeToggleToolTip}" Visibility="{Binding WindowsThemeToggleVisibility}" MouseRightButtonUp="WindowsThemeButton_MouseRightButtonUp" />
                        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Command="{Binding OpenSettingsCommand}" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" ToolTip="Settings" />
                        <Button Content="−" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" Click="MinimizeButton_Click" />
                        <Button Content="□" Style="{StaticResource TitleBarButtonStyle}" Width="36" MinWidth="36" IsEnabled="False" Opacity="0.55" />
                        <Button Content="X" Style="{StaticResource TitleCloseButtonStyle}" Width="36" MinWidth="36" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Visibility="Collapsed" Margin="10,7,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PowerButton" Grid.Column="0" Content="{Binding PowerModeButtonText}" ToolTip="{Binding PowerModeButtonToolTip}" Click="PowerButton_Click" Height="30" Padding="8,3" FontSize="12" HorizontalContentAlignment="Center">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding PowerModeButtonToolTip}" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="{Binding PowerEfficiencyMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="BestPowerEfficiency" />
                            <MenuItem Header="{Binding BalancedPowerModeMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="Balanced" />
                            <MenuItem Header="{Binding PerformancePowerModeMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="BestPerformance" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ModesButton" Grid.Column="2" Content="{Binding ModeChipText}" ToolTip="{Binding DellChargeSetting}" Click="ModesButton_Click" Height="30" Padding="8,3" FontSize="12" HorizontalContentAlignment="Center">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDellChargeModeAvailable}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding HealthBatteryPresetMenuText}" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Health" />
                            <MenuItem Header="{Binding BalancedBatteryPresetMenuText}" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Balanced" />
                            <MenuItem Header="Charge to Full: Standard" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Standard" />
                            <MenuItem Header="Primarily AC Use" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="PrimarilyAcUse" />
                            <MenuItem Header="Adaptive" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Adaptive" />
                            <Separator />
                            <MenuItem Header="Show Current Setting" Command="{Binding RefreshDellChargeCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="4" Content="⚙" Command="{Binding OpenSettingsCommand}" Width="42" Height="30" MinWidth="42" Padding="0" FontSize="14" ToolTip="Settings" />
            </Grid>

            <Grid Grid.Row="1" Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="118" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Battery" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BatteryPercentText}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding PowerStateText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding BatteryHealthSummaryText}" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="0,9,0,0" ToolTip="{Binding BatteryHealthToolTip}" />
                            </StackPanel>
                            <controls:BatteryGaugeControl Percentage="{Binding BatteryLevelPercent}" Accent="{DynamicResource AccentBrush}" Width="42" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10" Cursor="Hand" ToolTip="Open battery watts details">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ShowBatteryWattsDetailsCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Power" Foreground="{DynamicResource BatteryAccentBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BatteryPowerValueText}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding BatteryAveragePowerText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding BatteryRateValueText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Thermals" Foreground="{DynamicResource ThermalAccentBrush}" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Path Width="13" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThermalAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,2 A3,3 0 0 1 11,5 L11,11.5 A5,5 0 1 1 5,11.5 L5,5 A3,3 0 0 1 8,2 Z M8,5 L8,13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding ThermalTemperatureText}" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding ThermalModeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DellThermalProfileToolTip}" />
                            <TextBlock Text="{Binding ThermalPackagePowerText}" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Activity" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding ActivityCpuText}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActivityGpuText}" Foreground="{DynamicResource GpuAccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Background="{DynamicResource PanelBorder}" Height="1" Opacity="0.65" Margin="0,5,0,7" />
                            <TextBlock Text="Top process" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                            <TextBlock Text="{Binding PrimaryCpuDriverText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryCpuDriverToolTip}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Power Plan" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
                <Border Grid.Row="1" Background="{DynamicResource ButtonPanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="32" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="{Binding PowerEfficiencyMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="BestPowerEfficiency" Background="Transparent" BorderBrush="Transparent" FontSize="12" Padding="4,0" MinHeight="30" />
                                <Border Grid.Column="1" Background="{DynamicResource PanelBorder}" Margin="0,6" />
                                <Button Grid.Column="2" Content="{Binding BalancedPowerModeMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="Balanced" Background="Transparent" BorderBrush="Transparent" FontSize="12" Padding="4,0" MinHeight="30" />
                                <Border Grid.Column="3" Background="{DynamicResource PanelBorder}" Margin="0,6" />
                                <Button Grid.Column="4" Content="{Binding PerformancePowerModeMenuText}" Command="{Binding ApplyWindowsPowerModeCommand}" CommandParameter="BestPerformance" Background="Transparent" BorderBrush="Transparent" FontSize="12" Padding="4,0" MinHeight="30" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="2" Text="Mode" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDellChargeModeAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Height="32"
                                MinHeight="32"
                                Padding="10,0"
                                FontSize="12"
                                HorizontalContentAlignment="Left"
                                ToolTip="{Binding DellChargeSetting}"
                                Click="ChargeModeButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDellChargeModeAvailable}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" Data="M8,0 L8,5 L13,5 L6,16 L6,10 L1,10 Z" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ModeChipText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{Binding HealthBatteryPresetMenuText}" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Health" />
                                    <MenuItem Header="{Binding BalancedBatteryPresetMenuText}" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Balanced" />
                                    <MenuItem Header="Charge to Full: Standard" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Standard" />
                                    <MenuItem Header="Primarily AC Use" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="PrimarilyAcUse" />
                                    <MenuItem Header="Adaptive" Command="{Binding ApplyBatteryPresetCommand}" CommandParameter="Adaptive" />
                                    <Separator />
                                    <MenuItem Header="Show Current Setting" Command="{Binding RefreshDellChargeCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Padding="10,8">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDellThermalControlVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDellThermalControlVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Dell Thermal"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Background="{DynamicResource ButtonPanelBg}"
                                BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Height="34"
                                VerticalAlignment="Center"
                                ToolTip="{Binding DellThermalProfileToolTip}">
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDellThermalManualVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="1.35*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="{Binding OptimizedThermalProfileMenuText}" Command="{Binding ApplyDellThermalProfileCommand}" CommandParameter="Optimized" Background="Transparent" BorderBrush="Transparent" FontSize="11" Padding="3,0" MinHeight="32" />
                                <Border Grid.Column="1" Background="{DynamicResource PanelBorder}" Margin="0,7" />
                                <Button Grid.Column="2" Content="{Binding CoolThermalProfileMenuText}" Command="{Binding ApplyDellThermalProfileCommand}" CommandParameter="Cool" Background="Transparent" BorderBrush="Transparent" FontSize="11" Padding="3,0" MinHeight="32" />
                                <Border Grid.Column="3" Background="{DynamicResource PanelBorder}" Margin="0,7" />
                                <Button Grid.Column="4" Content="{Binding QuietThermalProfileMenuText}" Command="{Binding ApplyDellThermalProfileCommand}" CommandParameter="Quiet" Background="Transparent" BorderBrush="Transparent" FontSize="11" Padding="3,0" MinHeight="32" />
                                <Border Grid.Column="5" Background="{DynamicResource PanelBorder}" Margin="0,7" />
                                <Button Grid.Column="6" Content="{Binding UltraPerformanceThermalProfileMenuText}" Command="{Binding ApplyDellThermalProfileCommand}" CommandParameter="UltraPerformance" Background="Transparent" BorderBrush="Transparent" FontSize="11" Padding="3,0" MinHeight="32" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                            Background="{DynamicResource ButtonPanelBg}"
                                BorderBrush="{DynamicResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Height="34"
                                VerticalAlignment="Center"
                                ToolTip="{Binding DellThermalProfileToolTip}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDellThermalSyncVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="Synced with power plan"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DellThermalProfileText}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0,10,8" Visibility="{Binding DashboardGraphRowVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding BatteryWattsTileColumnWidth}" />
                    <ColumnDefinition Width="{Binding DashboardTileGapWidth}" />
                    <ColumnDefinition Width="{Binding CpuGpuUsageTileColumnWidth}" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Cursor="Hand" ToolTip="Open battery watts details" Visibility="{Binding BatteryWattsTileVisibility}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowBatteryWattsDetailsCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Path Width="13" Height="16" Stretch="Uniform" Fill="{DynamicResource BatteryAccentBrush}" Data="M9,0 L2,9 H7 L5,16 L14,6 H9 Z" Margin="0,1,7,0" />
                                <TextBlock Text="BATTERY WATTS" Foreground="{DynamicResource BatteryAccentBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,7,0,0">
                                <TextBlock Text="{Binding BatteryWattsGraphSummaryTop}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextAlignment="Left" />
                                <TextBlock Text="{Binding BatteryWattsGraphSummaryBottom}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                        <controls:SparklineControl Grid.Row="1" Values="{Binding BatteryWattsGraphValues}" Stroke="{DynamicResource BatteryAccentBrush}" Fill="{DynamicResource BatteryGraphFill}" Margin="0,3,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Cursor="Hand" ToolTip="Open CPU / GPU usage details" Visibility="{Binding CpuGpuUsageTileVisibility}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowUsageDetailsCommand}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,5 H13 V11 H3 Z M5,3 V5 M8,3 V5 M11,3 V5 M5,11 V13 M8,11 V13 M11,11 V13 M1,6 H3 M1,10 H3 M13,6 H15 M13,10 H15" Margin="0,2,7,0" />
                                <TextBlock Text="CPU / GPU USAGE" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,7,0,0">
                                <TextBlock Text="{Binding SystemUsageGraphSummaryTop}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextAlignment="Left" />
                                <TextBlock Text="{Binding SystemUsageGraphSummaryBottom}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                        <controls:SparklineControl Grid.Row="1"
                                                   Values="{Binding CpuGraphValues}"
                                                   SecondaryValues="{Binding GpuGraphValues}"
                                                   Stroke="{DynamicResource AccentBrush}"
                                     SecondaryStroke="{DynamicResource GpuAccentBrush}"
                                                   Fill="{DynamicResource CpuGraphFill}"
                                                   Minimum="0"
                                                   Margin="0,3,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚡  Battery watts" Foreground="{DynamicResource BatteryAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding BatteryWattsGraphSummary}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    </Grid>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding BatteryWattsGraphValues}" Stroke="{DynamicResource BatteryAccentBrush}" Fill="{DynamicResource BatteryGraphFill}" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="10,0,10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="♨  CPU temperature" Foreground="{DynamicResource ThermalAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding TemperatureGraphSummary}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    </Grid>
                    <controls:SparklineControl Grid.Row="1" Values="{Binding TemperatureGraphValues}" Stroke="{DynamicResource ThermalAccentBrush}" Fill="{DynamicResource ThermalGraphFill}" />
                </Grid>
            </Border>

            <TabControl Grid.Row="3"
                        Margin="10,0,10,8"
                        Visibility="{Binding BatteryUsageSectionVisibility}"
                        Style="{StaticResource SectionTabControlStyle}"
                        ItemContainerStyle="{StaticResource SectionTabItemStyle}"
                        SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">
                <TabItem Visibility="{Binding BatteryUsageSectionVisibility}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Rectangle Width="9" Height="12" RadiusX="1.6" RadiusY="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.8" Canvas.Left="3" Canvas.Top="3" />
                                    <Rectangle Width="4" Height="2" RadiusX="0.8" RadiusY="0.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <Rectangle Width="4" Height="6" RadiusX="1" RadiusY="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="Battery" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="170" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding BatteryUsageTitle}" Foreground="{DynamicResource GoodAccentBrush}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&lt;" Command="{Binding PreviousBatteryUsageDayCommand}" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0" FontSize="12" ToolTip="Previous day" />
                                <Button Content="{Binding BatteryUsageDateText}" Command="{Binding TodayBatteryUsageCommand}" Width="68" MinWidth="68" Height="26" MinHeight="26" Padding="4,0" FontSize="11" Margin="5,0" ToolTip="Today" />
                                <Button Content="&gt;" Command="{Binding NextBatteryUsageDayCommand}" IsEnabled="{Binding CanShowNextBatteryUsageDay}" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0" FontSize="12" ToolTip="Next day" />
                            </StackPanel>
                        </Grid>

                        <controls:BatteryUsageCombinedControl Grid.Row="1"
                                                              Buckets="{Binding BatteryUsageBuckets}"
                                                              SelectionCommand="{Binding SelectBatteryUsageRangeCommand}"
                                                              Height="170"
                                                              VerticalAlignment="Top"
                                                              Margin="0,0,0,0"
                                                              Cursor="Hand" />

                        <Grid Grid.Row="2" Margin="0,-2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="17" />
                                <RowDefinition Height="17" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding BatteryUsageSleepDrainText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{Binding BatteryUsageChargeBehaviorText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                <UniformGrid Columns="2" Rows="2" Width="16" Height="16">
                                    <Rectangle Margin="1.5" RadiusX="1.5" RadiusY="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.5" />
                                    <Rectangle Margin="1.5" RadiusX="1.5" RadiusY="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.5" />
                                    <Rectangle Margin="1.5" RadiusX="1.5" RadiusY="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.5" />
                                    <Rectangle Margin="1.5" RadiusX="1.5" RadiusY="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" StrokeThickness="1.5" />
                                </UniformGrid>
                            </Viewbox>
                            <TextBlock Text="Impact" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Windows battery usage (last 24h)" Foreground="{DynamicResource GoodAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="App" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Share" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBlock Text="{Binding WindowsBatteryUsageEmptyText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,8,8,0" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding WindowsBatteryUsageProcesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30" ToolTip="{Binding ToolTipText}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                    <TextBlock Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource MiniBarBg}" Height="5" CornerRadius="2.5" />
                                                    <ProgressBar Style="{StaticResource MiniBarStyle}" Value="{Binding BarPercent}" Maximum="100" Height="5" Foreground="{DynamicResource BatteryAccentBrush}" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding PercentText}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Grid.Row="3"
                                       Text="{Binding WindowsBatteryUsageAuditText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding WindowsBatteryUsageAuditText}" />
                        </Grid>

                        <Border Grid.Column="1" Background="{DynamicResource PanelBorder}" Opacity="0.65" Margin="10,2" />

                        <Grid Grid.Column="2" Margin="20,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Live resource impact" Foreground="{DynamicResource GoodAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Process / service" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="Score" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBlock Text="{Binding TopAppUsageEmptyText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding EnergyImpactProcesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="25" ToolTip="{Binding ResourceImpactToolTip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="52" />
                                                </Grid.ColumnDefinitions>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="{DynamicResource ImpactBadgeBg}" BorderBrush="{DynamicResource ImpactBadgeBorder}" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ResourceImpactBadgeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" />
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource MiniBarBg}" Height="5" CornerRadius="2.5" />
                                                    <ProgressBar Style="{StaticResource MiniBarStyle}" Value="{Binding EstimatedEnergyImpactBarPercent}" Maximum="100" Height="5" Foreground="{DynamicResource ImpactBarBrush}" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding ResourceImpactText}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="22" Margin="10,8,10,8" Background="{DynamicResource WindowBg}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBatteryWattsDetailsVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="139" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="206" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding HideBatteryWattsDetailsCommand}"
                                Content="&#xE72B;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ToolTip="Back" />
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Text="Battery Watts Details" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Detailed drain spikes, high-drain periods, and runtime context" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="5" Margin="0,12,0,0">
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="16" Height="18" Stretch="Uniform" Fill="{DynamicResource BatteryAccentBrush}" Data="M9,0 L2,9 H7 L5,16 L14,6 H9 Z" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Now" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryWattsNowDetailText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BatteryAccentBrush}" FontSize="16" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="10m Avg" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryWattsAverageDetailText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource BatteryAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,4 L6,9 L9,7 L14,14" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Min Drain" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryWattsMinDrainDetailText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource GoodAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,13 L6,8 L9,10 L14,3" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Max Charge" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryWattsMaxChargeDetailText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" FontSize="17" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Rate" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryWattsRateDetailText}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Path Width="13" Height="16" Stretch="Uniform" Fill="{DynamicResource BatteryAccentBrush}" Data="M9,0 L2,9 H7 L5,16 L14,6 H9 Z" Margin="0,1,8,0" />
                            <TextBlock Text="Battery Watts" Foreground="{DynamicResource BatteryAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>

                        <controls:UsageDetailGraphControl Grid.Row="1"
                                                          Values="{Binding BatteryDrainGraphValues}"
                                                          Peaks="{Binding BatteryDrainPeaks}"
                                                          Stroke="{DynamicResource BatteryAccentBrush}"
                                                          Fill="{DynamicResource BatteryGraphFill}"
                                                          AxisUnit=" W"
                                                          AxisFormat="N1"
                                                          IsSigned="True"
                                                          SmoothLine="True"
                                                          Margin="0,4,0,0" />

                    <Border Grid.Row="2" Background="{DynamicResource InsetPanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Margin="0,8,0,0">
                            <UniformGrid Columns="4" Margin="10,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BatteryAccentBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Avg Drain" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryDrainAverageDetailText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BatteryAccentBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Time &gt; 12 W" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryDrainTimeAbove12Text}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Samples" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding BatteryDrainSamplesDetailText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Drain Events" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{Binding BatteryDrainEventsEmptyText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{Binding BatteryDrainEvents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,4,12" ToolTip="{Binding ToolTipText}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BatteryAccentBrush}" Margin="8,0,0,0" />
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding DetailText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2" Text="{Binding ContextText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,1,0,3" TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Grid.Row="3" Style="{StaticResource MiniBarStyle}" Value="{Binding BarPercent}" Maximum="100" Height="5" Foreground="{DynamicResource BatteryAccentBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="21" Margin="10,8,10,8" Background="{DynamicResource WindowBg}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBatteryUsageDetailsVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="94" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="292" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding HideBatteryUsageDetailsCommand}"
                                Content="&#xE72B;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ToolTip="Back" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Text="Battery Usage Details" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedBatteryUsageTitle}" Foreground="{DynamicResource GoodAccentBrush}" FontSize="13" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedBatteryUsageSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding BatteryUsageTitle}" Foreground="{DynamicResource GoodAccentBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&lt;" Command="{Binding PreviousBatteryUsageDayCommand}" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0" FontSize="12" ToolTip="Previous day" />
                                <Button Content="{Binding BatteryUsageDateText}" Command="{Binding TodayBatteryUsageCommand}" Width="68" MinWidth="68" Height="26" MinHeight="26" Padding="4,0" FontSize="11" Margin="5,0" ToolTip="Today" />
                                <Button Content="&gt;" Command="{Binding NextBatteryUsageDayCommand}" IsEnabled="{Binding CanShowNextBatteryUsageDay}" Width="30" MinWidth="30" Height="26" MinHeight="26" Padding="0" FontSize="12" ToolTip="Next day" />
                            </StackPanel>
                        </Grid>
                        <controls:BatteryUsageCombinedControl Grid.Row="1"
                                                              Buckets="{Binding BatteryUsageBuckets}"
                                                              SelectedStart="{Binding SelectedBatteryUsageStart}"
                                                              SelectedEnd="{Binding SelectedBatteryUsageEnd}"
                                                              SelectionCommand="{Binding UpdateBatteryUsageRangeCommand}"
                                                              Height="230"
                                                              VerticalAlignment="Top"
                                                              Cursor="Hand" />
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Windows battery impact during selected range" Foreground="{DynamicResource GoodAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="App" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="Share" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding SelectedWindowsBatteryUsageEmptyText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding SelectedWindowsBatteryUsageProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30" ToolTip="{Binding ToolTipText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                <TextBlock Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource MiniBarBg}" Height="5" CornerRadius="2.5" />
                                                <ProgressBar Style="{StaticResource MiniBarStyle}" Value="{Binding BarPercent}" Maximum="100" Height="5" Foreground="{DynamicResource BatteryAccentBrush}" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <TextBlock Grid.Row="3"
                                   Text="{Binding SelectedBatteryUsageImpactAuditText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Bottom"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedBatteryUsageImpactAuditText}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="20" Margin="10,8,10,8" Background="{DynamicResource WindowBg}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUsageDetailsVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="139" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1.08*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="206" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding HideUsageDetailsCommand}"
                                Content="&#xE72B;"
                                FontFamily="Segoe MDL2 Assets"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ToolTip="Back" />
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Text="CPU / GPU Usage Details" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Detailed activity and recent CPU driver processes" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="5" Margin="0,12,0,0">
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,5 H13 V11 H3 Z M5,3 V5 M8,3 V5 M11,3 V5 M5,11 V13 M8,11 V13 M11,11 V13 M1,6 H3 M1,10 H3 M13,6 H15 M13,10 H15" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CPU Now" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding CpuNowDetailText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource GpuAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,5 H13 V11 H3 Z M5,3 V5 M8,3 V5 M11,3 V5 M5,11 V13 M8,11 V13 M11,11 V13 M1,6 H3 M1,10 H3 M13,6 H15 M13,10 H15" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="GPU Now" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding GpuNowDetailText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,13 L6,9 L9,11 L14,4 M11,4 H14 V7" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CPU Max" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding CpuMaxDetailText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54" Margin="0,0,8,0">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                        <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource GpuAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,13 L6,9 L9,11 L14,4 M11,4 H14 V7" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="GPU Max" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding GpuMaxDetailText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        <Border Background="{DynamicResource MetricCardBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Height="54">
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" FontSize="17" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Sampling" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding DetailSamplingText}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,5 H13 V11 H3 Z M5,3 V5 M8,3 V5 M11,3 V5 M5,11 V13 M8,11 V13 M11,11 V13 M1,6 H3 M1,10 H3 M13,6 H15 M13,10 H15" Margin="0,1,8,0" />
                            <TextBlock Text="CPU Usage" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
      

                        <controls:UsageDetailGraphControl Grid.Row="1"
                                                          Values="{Binding CpuGraphValues}"
                                                          Peaks="{Binding CpuUsagePeaks}"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          Fill="{DynamicResource CpuGraphFill}"
                                                          SmoothLine="True"
                                                          Margin="0,4,0,0" />

                    <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource InsetPanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Margin="0,8,0,0">
                            <UniformGrid Columns="3" Margin="10,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Average" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding CpuAverageDetailText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Total Time &gt; 50%" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding CpuTimeAbove50Text}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Samples" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding CpuSamplesDetailText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="CPU Drivers" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}">
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="MinWidth" Value="6" />
                                        <Setter Property="Background" Value="{DynamicResource WindowBg}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                    <Grid Width="6" Background="{DynamicResource WindowBg}">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsTabStop="False" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                                            <Border Width="6" Background="{DynamicResource ScrollbarThumb}" CornerRadius="3" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsTabStop="False" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Text="{Binding CpuDriverEmptyText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{Binding CpuDriverProcesses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,4,12" ToolTip="{Binding ToolTipText}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Text="{Binding NowAverageText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,1,0,0" />
                                                    <TextBlock Grid.Row="2" Text="{Binding MaxActiveText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,1,0,3" />
                                                    <Grid Grid.Row="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="42" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Style="{StaticResource MiniBarStyle}" Value="{Binding BarPercent}" Maximum="100" Height="5" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding TrendText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="GPU Apps" Foreground="{DynamicResource GpuAccentBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}">
                                        <Setter Property="Width" Value="6" />
                                        <Setter Property="MinWidth" Value="6" />
                                        <Setter Property="Background" Value="{DynamicResource WindowBg}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                    <Grid Width="6" Background="{DynamicResource WindowBg}">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" IsTabStop="False" />
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                                            <Border Width="6" Background="{DynamicResource ScrollbarThumb}" CornerRadius="3" />
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" IsTabStop="False" />
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel>
                                    <TextBlock Text="{Binding TopGpuUsageEmptyText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <ItemsControl ItemsSource="{Binding TopGpuProcesses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,4,12" ToolTip="{Binding ResourceImpactToolTip}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Text="{Binding GpuDetailText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,1,0,3" />
                                                    <ProgressBar Grid.Row="2" Style="{StaticResource MiniBarStyle}" Value="{Binding GpuPercent}" Maximum="100" Height="5" Foreground="{DynamicResource GpuAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource GpuAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,5 H13 V11 H3 Z M5,3 V5 M8,3 V5 M11,3 V5 M5,11 V13 M8,11 V13 M11,11 V13 M1,6 H3 M1,10 H3 M13,6 H15 M13,10 H15" Margin="0,1,8,0" />
                        <TextBlock Text="GPU Usage" Foreground="{DynamicResource GpuAccentBrush}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>

                        <controls:UsageDetailGraphControl Grid.Row="1"
                                                          Values="{Binding GpuGraphValues}"
                                                          Peaks="{Binding GpuUsagePeaks}"
                               Stroke="{DynamicResource GpuAccentBrush}"
                                                          Fill="{DynamicResource GpuGraphFill}"
                                                          SmoothLine="True"
                                                          Margin="0,4,0,0" />

                    <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource InsetPanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Margin="0,8,0,0">
                            <UniformGrid Columns="3" Margin="10,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GpuAccentBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Average" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding GpuAverageDetailText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource GpuAccentBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Total Time &gt; 50%" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding GpuTimeAbove50Text}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedTextBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="Samples" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding GpuSamplesDetailText}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>


            <Border Grid.Row="4" Background="{DynamicResource TopBarBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11">
                <TextBlock Text="{Binding FooterStatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0" />
            </Border>
        </Grid>
    </Border>
</Window>
